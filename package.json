{
  "name": "syncshell-webui",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/assets.mjs",
    "check": "npm run format:check && npm run lint && npm test",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "shell:format": "shfmt -w scripts/*.sh",
    "shell:lint": "shellcheck scripts/*.sh",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --config tests/playwright.config.mjs",
    "test:integration": "bash scripts/test-integration.sh",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "lucide-preact": "1.43.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "vite": "8.2.2"
  }
}
