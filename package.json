{
  "name": "syncshell-webui",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/assets.mjs",
    "check": "npm run format:check && npm run lint && npm run check:types && npm test",
    "check:types": "tsc --project jsconfig.json",
    "format": "prettier --write . --ignore-unknown && npm run shell:format",
    "format:check": "prettier --check . --ignore-unknown && shfmt -d scripts/*.sh",
    "lint": "eslint . && npm run shell:lint",
    "shell:format": "shfmt -w scripts/*.sh",
    "shell:lint": "shellcheck scripts/*.sh",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --config tests/playwright.config.mjs",
    "test:integration": "bash scripts/test-integration.sh",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "lucide-preact": "1.43.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
