@layer theme {
:root {
  --color-page: {{background}};
  --color-surface: {{surface}};
  --color-surface-muted: {{surface_dark}};
  --color-text: {{foreground}};
  --color-text-strong: {{foreground_light}};
  --color-text-muted: {{foreground_dark}};
  --color-border: {{muted}};
  --color-accent: {{accent}};
  --color-info: {{cyan}};
  --color-success: {{green}};
  --color-warning: {{yellow}};
  --color-danger: {{red}};
  --color-focus: {{cyan}};
}

body {
  color: {{foreground}};
  background-color: {{background}};
}

a {
  color: {{accent}};
}

.text-primary {
  color: {{blue}};
}

a:hover,
a:focus,
.text-info {
  color: {{cyan}};
}

.navbar,
.panel-footer,
.modal-footer,
.dropdown-menu,
.open > .dropdown-toggle {
  color: {{foreground}};
  background-color: {{surface_dark}};
  border-color: {{muted}};
}

.nav-tabs > li:not(.active):not(.disabled) > a,
.navbar-text,
.navbar-link,
.dropdown > a,
.dropdown-menu > li > a,
.hidden-xs > a {
  color: {{foreground}};
}

.dropdown-menu > li > a:hover,
.dropdown-menu > li > a:focus,
.nav-tabs > li > a:hover,
.nav-tabs > li > a:focus,
li.hidden-xs:hover,
.navbar-link:hover,
.navbar-link:focus {
  color: {{foreground_light}};
  background-color: {{selection}};
}

.dropdown-menu > .active > a,
.nav-tabs > li.active > a,
.nav-tabs > li.active > a:hover,
.nav-tabs > li.active > a:focus {
  color: {{foreground_light}};
  background-color: {{selection}};
  border-color: {{muted}};
}

.divider,
.nav-tabs,
.panel-group .panel-heading + .panel-collapse > .panel-body,
.panel-group .panel-heading + .panel-collapse > .list-group {
  border-color: {{muted}};
}

.divider,
.nav-tabs {
  background-color: {{muted}};
}

.panel,
.modal-content,
.popover {
  color: {{foreground}};
  background-color: {{background}};
  border-color: {{muted}};
}

.panel-default > .panel-heading,
.modal-header:not(.alert),
.well,
.form-control,
.form-control[readonly="readonly"],
.checkbox[disabled] {
  color: {{foreground}};
  background-color: {{surface}};
  border-color: {{muted}};
}

.section-stripe,
.table-striped > tbody > tr:nth-of-type(odd) {
  background-color: {{surface_dark}};
}

.help-block,
.checkbox[disabled] *,
.checkbox[disabled] .help-block {
  color: {{foreground_dark}};
}

.btn-default,
.pagination > li > a,
.pagination > li > span {
  color: {{foreground}};
  background-color: {{surface}};
  border-color: {{muted}};
}

.btn-default:hover,
.btn-default:focus,
.pagination > li > a:hover,
.pagination > li > a:focus {
  color: {{foreground_light}};
  background-color: {{selection}};
}

.btn-primary,
.panel-progress,
.progress-bar {
  background-color: {{accent}};
}

.btn-success,
.progress-bar-success {
  background-color: {{green}};
}

.btn-info,
.progress-bar-info {
  background-color: {{magenta}};
}

.btn-warning,
.progress-bar-warning {
  background-color: {{yellow}};
}

.btn-danger,
.progress-bar-danger,
.alert-danger {
  background-color: {{red}};
}

.alert-info {
  color: {{background}};
  background-color: {{cyan}};
}

.alert-warning,
.panel-warning > .panel-heading {
  color: {{background}};
  background-color: {{yellow}};
}

.text-success {
  color: {{green}};
}

.text-warning {
  color: {{orange}};
}

.folder-change-time,
.review-rechecking {
  color: {{yellow}};
}

.text-danger {
  color: {{red}};
}

.identicon rect {
  fill: {{foreground}};
}

.panel-warning .identicon rect,
.progress .frontal {
  fill: {{background}};
  color: {{background}};
}
}
